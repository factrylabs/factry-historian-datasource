{
  "uid": "e2e-lookup-tables",
  "title": "E2E Lookup Tables",
  "tags": ["e2e"],
  "timezone": "utc",
  "schemaVersion": 39,
  "version": 1,
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "page",
        "label": "Page",
        "type": "custom",
        "query": "1,2,3",
        "current": { "selected": true, "text": "2", "value": "2" },
        "options": [
          { "selected": false, "text": "1", "value": "1" },
          { "selected": true, "text": "2", "value": "2" },
          { "selected": false, "text": "3", "value": "3" }
        ]
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Line settings",
      "datasource": { "type": "factry-historian-datasource", "uid": "factry-historian-e2e" },
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 0 },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "factry-historian-datasource", "uid": "factry-historian-e2e" },
          "queryType": "LookupTableQuery",
          "tabIndex": 4,
          "seriesLimit": 50,
          "query": {
            "LookupTable": "ffffffff-ffff-ffff-ffff-ffffffffffff",
            "Columns": ["line", "setpoint"],
            "Limit": 20,
            "Page": "$page",
            "Filter": {
              "Condition": "or",
              "ConditionGroups": [
                {
                  "Filter": {
                    "Condition": "and",
                    "ConditionGroups": [
                      { "Column": "line", "Operator": "=", "Values": ["L1"] },
                      { "Column": "setpoint", "Operator": ">=", "Values": ["100"] }
                    ]
                  }
                },
                {
                  "Filter": {
                    "Condition": "and",
                    "ConditionGroups": [
                      { "Column": "line", "Operator": "=", "Values": ["L2"] },
                      { "Column": "active", "Operator": "=", "Values": ["true"] }
                    ]
                  }
                }
              ]
            }
          }
        }
      ]
    }
  ]
}
